<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp"
    android:background="#161618">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="아이젠하워 &amp; 오운완"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0일째"
            android:textColor="#2ECC71"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="#333333" />

    <!-- 4 Quadrants (2x2 Grid) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_q1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Q1 긴급: 0개"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_q3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="👥 Q3 대리: 0개"
                android:textColor="#FFB74D"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_q2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Q2 목표: 0개"
                android:textColor="#4CAF50"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_q4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🗑 Q4 휴식: 0개"
                android:textColor="#90A4AE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="#333333" />

    <!-- Urgent Task & Weekly Stats Row -->
    <TextView
        android:id="@+id/widget_urgent_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰ 최우선: 없음"
        android:textColor="#FFD54F"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_weekly_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏆 오운완 100%"
            android:textColor="#81C784"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_total_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전체: 0개"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
